{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/coding-agent-execution-receipt.schema.json",
  "title": "Local Evaluation Lifecycle Execution Receipt",
  "description": "Digest-consistency receipt; it does not provide cryptographic authenticity.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "runner_revision",
    "integrity_scope",
    "manifest_revision",
    "manifest_digest",
    "task_id",
    "task_revision",
    "fixture_id",
    "fixture_revision",
    "fixture_initial_digest",
    "pre_run_digest",
    "configuration_revision",
    "configuration_digest",
    "repetition_index",
    "control_snapshot",
    "agent_argv",
    "artifact_root",
    "artifact_inventory_digest",
    "artifact_contract_valid",
    "oracle_outcome",
    "steps"
  ],
  "properties": {
    "schema_version": {"const": "2"},
    "runner_revision": {"const": "execution-receipt-v2"},
    "integrity_scope": {"const": "local-digest-consistency-only"},
    "manifest_revision": {"$ref": "#/$defs/nonblank"},
    "manifest_digest": {"$ref": "#/$defs/nonzeroDigest"},
    "task_id": {"$ref": "#/$defs/nonblank"},
    "task_revision": {"$ref": "#/$defs/nonblank"},
    "fixture_id": {"$ref": "#/$defs/nonblank"},
    "fixture_revision": {"$ref": "#/$defs/nonblank"},
    "fixture_initial_digest": {"$ref": "#/$defs/nonzeroDigest"},
    "pre_run_digest": {
      "oneOf": [{"$ref": "#/$defs/nonzeroDigest"}, {"type": "null"}]
    },
    "configuration_revision": {"$ref": "#/$defs/nonblank"},
    "configuration_digest": {"$ref": "#/$defs/nonzeroDigest"},
    "repetition_index": {"type": "integer", "minimum": 1},
    "control_snapshot": {"$ref": "#/$defs/controlSnapshot"},
    "agent_argv": {"$ref": "#/$defs/argv"},
    "artifact_root": {"const": "artifacts"},
    "artifact_inventory_digest": {"$ref": "#/$defs/nonzeroDigest"},
    "artifact_contract_valid": {"type": "boolean"},
    "oracle_outcome": {"enum": ["pass", "fail", "not-run"]},
    "steps": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reset", "setup", "agent", "oracle"],
      "properties": {
        "reset": {"$ref": "#/$defs/step"},
        "setup": {"$ref": "#/$defs/step"},
        "agent": {"$ref": "#/$defs/step"},
        "oracle": {"$ref": "#/$defs/step"}
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"oracle_outcome": {"const": "pass"}},
        "required": ["oracle_outcome"]
      },
      "then": {
        "properties": {
          "artifact_contract_valid": {"const": true},
          "steps": {
            "properties": {
              "oracle": {
                "properties": {
                  "executed": {"const": true},
                  "timed_out": {"const": false},
                  "expected_exit_code": {"const": 0},
                  "exit_code": {"const": 0}
                }
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "nonblank": {"type": "string", "pattern": "\\S"},
    "nonzeroDigest": {
      "type": "string",
      "pattern": "^sha256:(?!0{64}$)[0-9a-f]{64}$"
    },
    "safeRelativePath": {
      "type": "string",
      "pattern": "^(?=.*\\S)(?!/)(?!.*\\\\)(?!.*:)(?!.*//)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*\\/$)[^\\u0000]+$"
    },
    "argv": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/nonblank"}
    },
    "controlSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "snapshot_revision",
        "source_scope",
        "agent",
        "agent_version",
        "model",
        "reasoning_effort",
        "profile",
        "configuration_revision",
        "configuration_digest",
        "permissions_digest",
        "toolset_digest",
        "repetition_index",
        "duration_seconds",
        "input_tokens",
        "output_tokens",
        "token_source"
      ],
      "properties": {
        "snapshot_revision": {"const": "control-snapshot-v1"},
        "source_scope": {"const": "runner-observed-plus-invocation-declared"},
        "agent": {"enum": ["codex", "claude-code", "deepseek-harness"]},
        "agent_version": {"$ref": "#/$defs/nonblank"},
        "model": {"$ref": "#/$defs/nonblank"},
        "reasoning_effort": {
          "enum": [
            "none",
            "minimal",
            "low",
            "medium",
            "high",
            "xhigh",
            "max",
            "ultra",
            "not-applicable"
          ]
        },
        "profile": {"enum": ["quality", "balanced", "economy", "custom"]},
        "configuration_revision": {"$ref": "#/$defs/nonblank"},
        "configuration_digest": {"$ref": "#/$defs/nonzeroDigest"},
        "permissions_digest": {"$ref": "#/$defs/nonzeroDigest"},
        "toolset_digest": {"$ref": "#/$defs/nonzeroDigest"},
        "repetition_index": {"type": "integer", "minimum": 1},
        "duration_seconds": {"type": ["number", "null"], "minimum": 0},
        "input_tokens": {"type": "null"},
        "output_tokens": {"type": "null"},
        "token_source": {"const": "unavailable"}
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "digest"],
      "properties": {
        "path": {"$ref": "#/$defs/safeRelativePath"},
        "digest": {"$ref": "#/$defs/nonzeroDigest"}
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "argv",
        "executed",
        "expected_exit_code",
        "exit_code",
        "timed_out",
        "stdout",
        "stderr"
      ],
      "properties": {
        "argv": {"$ref": "#/$defs/argv"},
        "executed": {"type": "boolean"},
        "expected_exit_code": {"const": 0},
        "exit_code": {"type": ["integer", "null"]},
        "timed_out": {"type": "boolean"},
        "stdout": {"oneOf": [{"$ref": "#/$defs/output"}, {"type": "null"}]},
        "stderr": {"oneOf": [{"$ref": "#/$defs/output"}, {"type": "null"}]}
      },
      "allOf": [
        {
          "if": {
            "properties": {"executed": {"const": false}},
            "required": ["executed"]
          },
          "then": {
            "properties": {
              "exit_code": {"type": "null"},
              "timed_out": {"const": false},
              "stdout": {"type": "null"},
              "stderr": {"type": "null"}
            }
          },
          "else": {
            "properties": {
              "stdout": {"$ref": "#/$defs/output"},
              "stderr": {"$ref": "#/$defs/output"}
            }
          }
        },
        {
          "if": {
            "properties": {
              "executed": {"const": true},
              "timed_out": {"const": true}
            },
            "required": ["executed", "timed_out"]
          },
          "then": {"properties": {"exit_code": {"type": "null"}}},
          "else": {
            "if": {
              "properties": {"executed": {"const": true}},
              "required": ["executed"]
            },
            "then": {"properties": {"exit_code": {"type": "integer"}}}
          }
        }
      ]
    }
  }
}
