{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/schemas/authorization-grant.schema.json",
  "title": "One-shot calibration authorization grant",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "grant_revision",
    "grant_id",
    "nonce",
    "source",
    "decision",
    "platform",
    "batch_id",
    "batch_digest",
    "installation_identity_digest",
    "authorized_actions",
    "forbidden_actions",
    "allowed_egress",
    "network_scope",
    "max_cli_invocations",
    "max_provider_requests",
    "max_billed_cost_usd",
    "billed_cost_limit_source",
    "expires_at"
  ],
  "properties": {
    "schema_version": { "const": "1" },
    "grant_revision": { "const": "calibration-authorization-grant-v1" },
    "grant_id": { "$ref": "#/$defs/nonblank" },
    "nonce": { "$ref": "#/$defs/nonblank" },
    "source": { "const": "interactive-user-authorization" },
    "decision": { "const": "approved-once" },
    "platform": { "const": "codex" },
    "batch_id": { "$ref": "#/$defs/nonblank" },
    "batch_digest": { "$ref": "#/$defs/digest" },
    "installation_identity_digest": { "$ref": "#/$defs/digest" },
    "authorized_actions": {
      "type": "array",
      "const": [
        "model-request",
        "codex-client-network-transport",
        "synthetic-fixture-prompt-egress",
        "local-receipt-and-artifact-write",
        "authorization-consumption-registry-write"
      ]
    },
    "forbidden_actions": {
      "type": "array",
      "const": [
        "retry",
        "web-search",
        "browser",
        "mcp",
        "agent-tool-use",
        "credential-content-inspection",
        "user-config-write",
        "git-write",
        "external-side-effect"
      ]
    },
    "allowed_egress": {
      "type": "array",
      "const": ["synthetic-fixture-prompt"]
    },
    "network_scope": { "const": "codex-client-network-endpoints-unverified" },
    "max_cli_invocations": { "const": 1 },
    "max_provider_requests": { "type": "null" },
    "max_billed_cost_usd": { "type": "null" },
    "billed_cost_limit_source": { "const": "unknown-no-verifiable-cap" },
    "expires_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "nonblank": {
      "type": "string",
      "minLength": 1,
      "pattern": ".*\\S.*"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
