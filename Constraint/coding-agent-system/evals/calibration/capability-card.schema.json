{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/schemas/capability-card.schema.json",
  "title": "Coding agent capability card",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "card_id",
    "card_revision",
    "platform",
    "execution_configuration",
    "evidence_state",
    "evidence_basis",
    "state_reason",
    "observed_runs",
    "task_shapes",
    "outcome_summary",
    "batch_binding",
    "measurements",
    "evidence",
    "blockers",
    "valid_until",
    "expired_reason",
    "decision"
  ],
  "properties": {
    "schema_version": { "const": "1" },
    "card_id": { "$ref": "#/$defs/nonblank" },
    "card_revision": { "$ref": "#/$defs/nonblank" },
    "platform": { "$ref": "#/$defs/platform" },
    "execution_configuration": { "$ref": "#/$defs/executionConfiguration" },
    "evidence_state": {
      "enum": [
        "unobserved",
        "smoke-only",
        "provisionally-calibrated",
        "expired"
      ]
    },
    "evidence_basis": {
      "enum": [
        "none",
        "single-smoke",
        "preregistered-calibration-batch",
        "expired-tombstone"
      ]
    },
    "state_reason": { "$ref": "#/$defs/stateReasonCode" },
    "observed_runs": { "type": "integer", "minimum": 0 },
    "task_shapes": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/nonblank" }
    },
    "outcome_summary": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/outcomeSummary" }
      ]
    },
    "batch_binding": { "$ref": "#/$defs/batchBinding" },
    "measurements": { "$ref": "#/$defs/measurements" },
    "evidence": {
      "type": "array",
      "items": { "$ref": "#/$defs/evidenceItem" }
    },
    "blockers": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/capabilityBlockerCode" }
    },
    "valid_until": {
      "oneOf": [
        { "type": "null" },
        { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" }
      ]
    },
    "expired_reason": { "$ref": "#/$defs/nullableExpiredReasonCode" },
    "decision": { "$ref": "#/$defs/decision" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "evidence_state": { "const": "unobserved" } },
        "required": ["evidence_state"]
      },
      "then": {
        "properties": {
          "evidence_basis": { "const": "none" },
          "state_reason": { "const": "unobserved-no-retained-observation" },
          "observed_runs": { "const": 0 },
          "task_shapes": { "maxItems": 0 },
          "outcome_summary": { "type": "null" },
          "batch_binding": {
            "properties": { "state": { "const": "none" } }
          },
          "evidence": { "maxItems": 0 },
          "expired_reason": { "type": "null" },
          "measurements": {
            "properties": {
              "provider_usage": { "properties": { "status": { "const": "unknown" } } },
              "derived_usage": { "properties": { "status": { "const": "unknown" } } },
              "billed_cost": { "properties": { "status": { "const": "unknown" } } },
              "derived_cost": { "properties": { "status": { "const": "unknown" } } }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "evidence_state": { "const": "smoke-only" } },
        "required": ["evidence_state"]
      },
      "then": {
        "properties": {
          "evidence_basis": { "const": "single-smoke" },
          "observed_runs": { "const": 1 },
          "task_shapes": { "minItems": 1, "maxItems": 1 },
          "outcome_summary": { "$ref": "#/$defs/outcomeSummary" },
          "batch_binding": {
            "properties": { "state": { "const": "receipt-bound" } }
          },
          "evidence": { "minItems": 1, "maxItems": 1 },
          "valid_until": { "type": "string" },
          "expired_reason": { "type": "null" },
          "execution_configuration": {
            "properties": { "binding_state": { "const": "receipt-bound" } }
          }
        },
        "oneOf": [
          {
            "properties": {
              "state_reason": { "const": "smoke-only-completed" },
              "outcome_summary": {
                "properties": {
                  "completed": { "const": 1 },
                  "failed": { "const": 0 },
                  "stopped": { "const": 0 }
                }
              }
            }
          },
          {
            "properties": {
              "state_reason": { "const": "smoke-only-failed" },
              "outcome_summary": {
                "properties": {
                  "completed": { "const": 0 },
                  "failed": { "const": 1 },
                  "stopped": { "const": 0 }
                }
              }
            }
          },
          {
            "properties": {
              "state_reason": { "const": "smoke-only-stopped" },
              "outcome_summary": {
                "properties": {
                  "completed": { "const": 0 },
                  "failed": { "const": 0 },
                  "stopped": { "const": 1 }
                }
              }
            }
          }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "evidence_state": { "const": "provisionally-calibrated" }
        },
        "required": ["evidence_state"]
      },
      "then": {
        "properties": {
          "evidence_basis": { "const": "preregistered-calibration-batch" },
          "observed_runs": { "minimum": 2 },
          "task_shapes": { "minItems": 2 },
          "outcome_summary": { "$ref": "#/$defs/outcomeSummary" },
          "batch_binding": {
            "properties": { "state": { "const": "receipt-bound" } }
          },
          "evidence": { "minItems": 2 },
          "valid_until": { "type": "string" },
          "expired_reason": { "type": "null" },
          "execution_configuration": {
            "properties": { "binding_state": { "const": "receipt-bound" } }
          }
        },
        "oneOf": [
          {
            "properties": {
              "state_reason": { "const": "provisionally-calibrated-completed" },
              "outcome_summary": {
                "properties": {
                  "completed": { "minimum": 1 },
                  "failed": { "const": 0 },
                  "stopped": { "const": 0 }
                }
              }
            }
          },
          {
            "properties": {
              "state_reason": { "const": "provisionally-calibrated-failed" },
              "outcome_summary": {
                "properties": {
                  "completed": { "const": 0 },
                  "failed": { "minimum": 1 },
                  "stopped": { "const": 0 }
                }
              }
            }
          },
          {
            "properties": {
              "state_reason": { "const": "provisionally-calibrated-stopped" },
              "outcome_summary": {
                "properties": {
                  "completed": { "const": 0 },
                  "failed": { "const": 0 },
                  "stopped": { "minimum": 1 }
                }
              }
            }
          },
          {
            "properties": {
              "state_reason": { "const": "provisionally-calibrated-mixed-outcomes" },
              "outcome_summary": {
                "anyOf": [
                  {
                    "properties": {
                      "completed": { "minimum": 1 },
                      "failed": { "minimum": 1 }
                    }
                  },
                  {
                    "properties": {
                      "completed": { "minimum": 1 },
                      "stopped": { "minimum": 1 }
                    }
                  },
                  {
                    "properties": {
                      "failed": { "minimum": 1 },
                      "stopped": { "minimum": 1 }
                    }
                  }
                ]
              }
            }
          }
        ]
      }
    },
    {
      "if": {
        "properties": { "evidence_state": { "const": "expired" } },
        "required": ["evidence_state"]
      },
      "then": {
        "properties": {
          "evidence_basis": { "const": "expired-tombstone" },
          "state_reason": { "const": "expired-claim-free-tombstone" },
          "observed_runs": { "const": 0 },
          "task_shapes": { "maxItems": 0 },
          "outcome_summary": { "type": "null" },
          "batch_binding": {
            "properties": { "state": { "const": "none" } }
          },
          "evidence": { "maxItems": 0 },
          "valid_until": { "type": "string" },
          "expired_reason": { "$ref": "#/$defs/expiredReasonCode" },
          "measurements": {
            "properties": {
              "provider_usage": { "properties": { "status": { "const": "unknown" } } },
              "derived_usage": { "properties": { "status": { "const": "unknown" } } },
              "billed_cost": { "properties": { "status": { "const": "unknown" } } },
              "derived_cost": { "properties": { "status": { "const": "unknown" } } }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "nonblank": {
      "type": "string",
      "minLength": 1,
      "pattern": ".*\\S.*"
    },
    "nullableNonblank": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/nonblank" }
      ]
    },
    "stateReasonCode": {
      "enum": [
        "unobserved-no-retained-observation",
        "smoke-only-completed",
        "smoke-only-failed",
        "smoke-only-stopped",
        "provisionally-calibrated-completed",
        "provisionally-calibrated-failed",
        "provisionally-calibrated-stopped",
        "provisionally-calibrated-mixed-outcomes",
        "expired-claim-free-tombstone"
      ]
    },
    "capabilityBlockerCode": {
      "enum": [
        "real-model-request-not-run",
        "execution-configuration-not-control-bound",
        "provider-wire-request-count-cannot-be-enforced-to-one-for-the-built-in-chatgpt-provider-path",
        "codex-package-publisher-authenticity-and-provider-model-identity-remain-unverified",
        "revised-one-cli-invocation-authorization-required-before-real-smoke",
        "public-version-pinned-dsh-cli-not-available-on-path",
        "headless-execution-configuration-not-bindable"
      ]
    },
    "executionConfigurationBlockerCode": {
      "enum": [
        "public-version-pinned-dsh-cli-not-available-on-path",
        "control-digest-drift"
      ]
    },
    "nullableExecutionConfigurationBlockerCode": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/executionConfigurationBlockerCode" }
      ]
    },
    "expiredReasonCode": {
      "const": "evidence-validity-window-elapsed"
    },
    "nullableExpiredReasonCode": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/expiredReasonCode" }
      ]
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "nullableDigest": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/digest" }
      ]
    },
    "safePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+"
    },
    "nullableSafePath": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/safePath" }
      ]
    },
    "platform": {
      "enum": ["codex", "claude-code", "deepseek-harness"]
    },
    "executionConfiguration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "configuration_id",
        "platform",
        "harness",
        "client_version",
        "requested_model",
        "resolved_model",
        "model_resolution_status",
        "reasoning",
        "profile",
        "permissions_digest",
        "toolset_digest",
        "adapter_revision",
        "binding_state",
        "blocker"
      ],
      "properties": {
        "configuration_id": { "$ref": "#/$defs/nonblank" },
        "platform": { "$ref": "#/$defs/platform" },
        "harness": { "$ref": "#/$defs/nonblank" },
        "client_version": { "$ref": "#/$defs/nonblank" },
        "requested_model": { "$ref": "#/$defs/nullableNonblank" },
        "resolved_model": { "$ref": "#/$defs/nullableNonblank" },
        "model_resolution_status": {
          "enum": ["not-observed", "client-catalog-alias", "provider-resolved-id"]
        },
        "reasoning": { "$ref": "#/$defs/nullableNonblank" },
        "profile": { "$ref": "#/$defs/nonblank" },
        "permissions_digest": { "$ref": "#/$defs/nullableDigest" },
        "toolset_digest": { "$ref": "#/$defs/nullableDigest" },
        "adapter_revision": { "$ref": "#/$defs/nonblank" },
        "binding_state": {
          "enum": [
            "declared-unbound",
            "control-bound",
            "receipt-bound",
            "blocked"
          ]
        },
        "blocker": { "$ref": "#/$defs/nullableExecutionConfigurationBlockerCode" }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "binding_state": { "enum": ["control-bound", "receipt-bound"] }
            },
            "required": ["binding_state"]
          },
          "then": {
            "properties": {
              "requested_model": { "$ref": "#/$defs/nonblank" },
              "model_resolution_status": {
                "enum": ["client-catalog-alias", "provider-resolved-id"]
              },
              "permissions_digest": { "$ref": "#/$defs/digest" },
              "toolset_digest": { "$ref": "#/$defs/digest" },
              "blocker": { "type": "null" }
            }
          }
        },
        {
          "if": {
            "properties": { "binding_state": { "const": "blocked" } },
            "required": ["binding_state"]
          },
          "then": {
            "properties": {
              "requested_model": { "type": "null" },
              "resolved_model": { "type": "null" },
              "model_resolution_status": { "const": "not-observed" },
              "permissions_digest": { "type": "null" },
              "toolset_digest": { "type": "null" },
              "blocker": { "$ref": "#/$defs/executionConfigurationBlockerCode" }
            }
          },
          "else": { "properties": { "blocker": { "type": "null" } } }
        },
        {
          "if": {
            "properties": { "binding_state": { "const": "declared-unbound" } },
            "required": ["binding_state"]
          },
          "then": {
            "properties": {
              "requested_model": { "type": "null" },
              "resolved_model": { "type": "null" },
              "model_resolution_status": { "const": "not-observed" },
              "permissions_digest": { "type": "null" },
              "toolset_digest": { "type": "null" }
            }
          }
        },
        {
          "if": {
            "properties": { "model_resolution_status": { "const": "client-catalog-alias" } },
            "required": ["model_resolution_status"]
          },
          "then": {
            "properties": {
              "requested_model": { "$ref": "#/$defs/nonblank" },
              "resolved_model": { "type": "null" }
            }
          }
        },
        {
          "if": {
            "properties": { "model_resolution_status": { "const": "provider-resolved-id" } },
            "required": ["model_resolution_status"]
          },
          "then": {
            "properties": {
              "requested_model": { "$ref": "#/$defs/nonblank" },
              "resolved_model": { "$ref": "#/$defs/nonblank" }
            }
          }
        }
      ]
    },
    "providerUsage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "input_tokens",
        "output_tokens",
        "cached_input_tokens",
        "reasoning_output_tokens",
        "receipt_ref"
      ],
      "properties": {
        "status": { "enum": ["unknown", "provider-receipt"] },
        "input_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "output_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "cached_input_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "reasoning_output_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "receipt_ref": { "$ref": "#/$defs/nullableSafePath" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "status": { "const": "unknown" } },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "input_tokens": { "type": "null" },
              "output_tokens": { "type": "null" },
              "cached_input_tokens": { "type": "null" },
              "reasoning_output_tokens": { "type": "null" },
              "receipt_ref": { "type": "null" }
            }
          },
          "else": {
            "properties": {
              "input_tokens": { "type": "integer" },
              "output_tokens": { "type": "integer" },
              "receipt_ref": { "$ref": "#/$defs/safePath" }
            }
          }
        }
      ]
    },
    "derivedUsage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "input_tokens", "output_tokens", "method"],
      "properties": {
        "status": { "enum": ["unknown", "derived-estimate"] },
        "input_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "output_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "method": { "$ref": "#/$defs/nullableNonblank" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "status": { "const": "unknown" } },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "input_tokens": { "type": "null" },
              "output_tokens": { "type": "null" },
              "method": { "type": "null" }
            }
          },
          "else": {
            "properties": {
              "input_tokens": { "type": "integer" },
              "output_tokens": { "type": "integer" },
              "method": { "$ref": "#/$defs/nonblank" }
            }
          }
        }
      ]
    },
    "billedCost": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "amount_usd", "receipt_ref"],
      "properties": {
        "status": { "enum": ["unknown", "provider-billed"] },
        "amount_usd": { "type": ["number", "null"], "minimum": 0 },
        "receipt_ref": { "$ref": "#/$defs/nullableSafePath" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "status": { "const": "unknown" } },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "amount_usd": { "type": "null" },
              "receipt_ref": { "type": "null" }
            }
          },
          "else": {
            "properties": {
              "amount_usd": { "type": "number" },
              "receipt_ref": { "$ref": "#/$defs/safePath" }
            }
          }
        }
      ]
    },
    "derivedCost": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "amount_usd", "method"],
      "properties": {
        "status": { "enum": ["unknown", "derived-estimate"] },
        "amount_usd": { "type": ["number", "null"], "minimum": 0 },
        "method": { "$ref": "#/$defs/nullableNonblank" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "status": { "const": "unknown" } },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "amount_usd": { "type": "null" },
              "method": { "type": "null" }
            }
          },
          "else": {
            "properties": {
              "amount_usd": { "type": "number" },
              "method": { "$ref": "#/$defs/nonblank" }
            }
          }
        }
      ]
    },
    "measurements": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider_usage", "derived_usage", "billed_cost", "derived_cost"],
      "properties": {
        "provider_usage": { "$ref": "#/$defs/providerUsage" },
        "derived_usage": { "$ref": "#/$defs/derivedUsage" },
        "billed_cost": { "$ref": "#/$defs/billedCost" },
        "derived_cost": { "$ref": "#/$defs/derivedCost" }
      }
    },
    "stopReasonCount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason", "count"],
      "properties": {
        "reason": { "$ref": "#/$defs/nonblank" },
        "count": { "type": "integer", "minimum": 1 }
      }
    },
    "outcomeSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["completed", "failed", "stopped", "stop_reasons"],
      "properties": {
        "completed": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 },
        "stopped": { "type": "integer", "minimum": 0 },
        "stop_reasons": {
          "type": "array",
          "items": { "$ref": "#/$defs/stopReasonCount" }
        }
      }
    },
    "batchBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "batch_id",
        "batch_path",
        "batch_digest",
        "planned_runs",
        "retained_runs",
        "observed_runs",
        "planned_task_shapes",
        "retained_task_shapes",
        "observed_task_shapes"
      ],
      "properties": {
        "state": { "enum": ["none", "receipt-bound"] },
        "batch_id": { "$ref": "#/$defs/nullableNonblank" },
        "batch_path": { "$ref": "#/$defs/nullableSafePath" },
        "batch_digest": { "$ref": "#/$defs/nullableDigest" },
        "planned_runs": { "type": "integer", "minimum": 0 },
        "retained_runs": { "type": "integer", "minimum": 0 },
        "observed_runs": { "type": "integer", "minimum": 0 },
        "planned_task_shapes": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonblank" }
        },
        "retained_task_shapes": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonblank" }
        },
        "observed_task_shapes": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonblank" }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "state": { "const": "none" } },
            "required": ["state"]
          },
          "then": {
            "properties": {
              "batch_id": { "type": "null" },
              "batch_path": { "type": "null" },
              "batch_digest": { "type": "null" },
              "planned_runs": { "const": 0 },
              "retained_runs": { "const": 0 },
              "observed_runs": { "const": 0 },
              "planned_task_shapes": { "maxItems": 0 },
              "retained_task_shapes": { "maxItems": 0 },
              "observed_task_shapes": { "maxItems": 0 }
            }
          },
          "else": {
            "properties": {
              "batch_id": { "$ref": "#/$defs/nonblank" },
              "batch_path": { "$ref": "#/$defs/safePath" },
              "batch_digest": { "$ref": "#/$defs/digest" },
              "planned_runs": { "minimum": 1 },
              "retained_runs": { "minimum": 1 },
              "observed_runs": { "minimum": 1 },
              "planned_task_shapes": { "minItems": 1 },
              "retained_task_shapes": { "minItems": 1 },
              "observed_task_shapes": { "minItems": 1 }
            }
          }
        }
      ]
    },
    "evidenceItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "observation_id", "path", "digest"],
      "properties": {
        "type": { "const": "smoke-observation" },
        "observation_id": { "$ref": "#/$defs/nonblank" },
        "path": { "$ref": "#/$defs/safePath" },
        "digest": { "$ref": "#/$defs/digest" }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["routing", "winner", "ranking", "promotion_recommendation"],
      "properties": {
        "routing": { "const": "undecided" },
        "winner": { "type": "null" },
