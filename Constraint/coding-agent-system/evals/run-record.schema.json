{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/coding-agent-run-record.schema.json",
  "title": "Coding Agent Manifest/Receipt-Bound Run Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id",
    "task_revision",
    "fixture_id",
    "fixture_revision",
    "fixture_readiness",
    "initial_state_digest",
    "manifest_revision",
    "manifest_digest",
    "agent",
    "agent_version",
    "model",
    "reasoning_effort",
    "profile",
    "configuration_revision",
    "configuration_digest",
    "permissions_digest",
    "toolset_digest",
    "control_binding_status",
    "repetition_index",
    "run_status",
    "stop_reason",
    "oracle_outcome",
    "rubric_revision",
    "scorer_revision",
    "scores",
    "rework_count",
    "unverified_claims",
    "unsafe_actions",
    "duration_seconds",
    "input_tokens",
    "output_tokens",
    "token_source",
    "receipt_path",
    "receipt_digest",
    "artifact_root",
    "artifact_inventory_digest",
    "assessment_binding_status",
    "assessment_path",
    "assessment_digest",
    "evidence"
  ],
  "properties": {
    "task_id": {"$ref": "#/$defs/nonblank"},
    "task_revision": {"$ref": "#/$defs/nonblank"},
    "fixture_id": {"$ref": "#/$defs/nonblank"},
    "fixture_revision": {"$ref": "#/$defs/nonblank"},
    "fixture_readiness": {"enum": ["ready", "contract-only"]},
    "initial_state_digest": {"$ref": "#/$defs/digest"},
    "manifest_revision": {"$ref": "#/$defs/nonblank"},
    "manifest_digest": {"$ref": "#/$defs/digest"},
    "agent": {"enum": ["codex", "claude-code", "deepseek-harness"]},
    "agent_version": {"$ref": "#/$defs/nonblank"},
    "model": {"$ref": "#/$defs/nonblank"},
    "reasoning_effort": {
      "enum": [
        "none",
        "minimal",
        "low",
        "medium",
        "high",
        "xhigh",
        "max",
        "ultra",
        "not-applicable"
      ]
    },
    "profile": {"enum": ["quality", "balanced", "economy", "custom"]},
    "configuration_revision": {"$ref": "#/$defs/nonblank"},
    "configuration_digest": {"$ref": "#/$defs/digest"},
    "permissions_digest": {"$ref": "#/$defs/digest"},
    "toolset_digest": {"$ref": "#/$defs/digest"},
    "control_binding_status": {"enum": ["declared", "receipt-bound"]},
    "repetition_index": {"type": "integer", "minimum": 1},
    "run_status": {"enum": ["completed", "stopped", "failed"]},
    "stop_reason": {"$ref": "#/$defs/nonblank"},
    "oracle_outcome": {"enum": ["pass", "fail", "not-run"]},
    "rubric_revision": {"$ref": "#/$defs/nonblank"},
    "scorer_revision": {"$ref": "#/$defs/nonblank"},
    "scores": {"$ref": "#/$defs/scores"},
    "rework_count": {"type": "integer", "minimum": 0},
    "unverified_claims": {"type": "integer", "minimum": 0},
    "unsafe_actions": {"type": "integer", "minimum": 0},
    "duration_seconds": {"type": ["number", "null"], "minimum": 0},
    "input_tokens": {"type": ["integer", "null"], "minimum": 0},
    "output_tokens": {"type": ["integer", "null"], "minimum": 0},
    "token_source": {"enum": ["unavailable", "provider-receipt"]},
    "receipt_path": {"$ref": "#/$defs/safeRelativePath"},
    "receipt_digest": {"$ref": "#/$defs/digest"},
    "artifact_root": {"$ref": "#/$defs/safeRelativePath"},
    "artifact_inventory_digest": {"$ref": "#/$defs/digest"},
    "assessment_binding_status": {"enum": ["declared", "assessor-bound"]},
    "assessment_path": {
      "oneOf": [{"$ref": "#/$defs/safeRelativePath"}, {"type": "null"}]
    },
    "assessment_digest": {
      "oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/evidence"}
    },
    "notes": {"type": "string"}
  },
  "allOf": [
    {
      "if": {
        "properties": {"fixture_readiness": {"const": "contract-only"}},
        "required": ["fixture_readiness"]
      },
      "then": {
        "properties": {
          "control_binding_status": {"const": "declared"},
          "assessment_binding_status": {"const": "declared"}
        }
      }
    },
    {
      "if": {
        "properties": {"assessment_binding_status": {"const": "declared"}},
        "required": ["assessment_binding_status"]
      },
      "then": {
        "properties": {
          "assessment_path": {"type": "null"},
          "assessment_digest": {"type": "null"}
        }
      },
      "else": {
        "properties": {
          "control_binding_status": {"const": "receipt-bound"},
          "assessment_path": {"$ref": "#/$defs/safeRelativePath"},
          "assessment_digest": {"$ref": "#/$defs/nonzeroDigest"}
        }
      }
    },
    {
      "if": {
        "properties": {"token_source": {"const": "unavailable"}},
        "required": ["token_source"]
      },
      "then": {
        "properties": {
          "input_tokens": {"type": "null"},
          "output_tokens": {"type": "null"}
        }
      },
      "else": {
        "properties": {
          "input_tokens": {"type": "integer", "minimum": 0},
          "output_tokens": {"type": "integer", "minimum": 0}
        }
      }
    },
    {
      "if": {
        "properties": {"fixture_readiness": {"const": "ready"}},
        "required": ["fixture_readiness"]
      },
      "then": {
        "properties": {
          "initial_state_digest": {"$ref": "#/$defs/nonzeroDigest"},
          "manifest_digest": {"$ref": "#/$defs/nonzeroDigest"},
          "configuration_digest": {"$ref": "#/$defs/nonzeroDigest"},
          "permissions_digest": {"$ref": "#/$defs/nonzeroDigest"},
          "toolset_digest": {"$ref": "#/$defs/nonzeroDigest"},
          "receipt_digest": {"$ref": "#/$defs/nonzeroDigest"},
          "artifact_inventory_digest": {"$ref": "#/$defs/nonzeroDigest"},
          "evidence": {
            "items": {
              "properties": {"digest": {"$ref": "#/$defs/nonzeroDigest"}}
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {"run_status": {"const": "completed"}},
        "required": ["run_status"]
      },
      "then": {
        "properties": {
          "stop_reason": {"const": "task_completed"},
          "oracle_outcome": {"const": "pass"}
        }
      },
      "else": {
        "not": {
          "properties": {
            "scores": {
              "properties": {
                "requirements": {"const": 5},
                "correctness": {"const": 5},
                "verification": {"const": 5},
                "code_quality": {"const": 5},
                "scope_discipline": {"const": 5},
                "product_quality": {"const": 5},
                "instruction_fidelity": {"const": 5},
                "context_governance": {"const": 5}
              },
              "required": [
                "requirements",
                "correctness",
                "verification",
                "code_quality",
                "scope_discipline",
                "product_quality",
                "instruction_fidelity",
                "context_governance"
              ]
            }
          },
          "required": ["scores"]
        }
      }
    }
  ],
  "$defs": {
    "nonblank": {"type": "string", "pattern": "\\S"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "nonzeroDigest": {
      "type": "string",
      "pattern": "^sha256:(?!0{64}$)[0-9a-f]{64}$"
    },
    "safeRelativePath": {
      "type": "string",
      "pattern": "^(?=.*\\S)(?!/)(?!.*\\\\)(?!.*:)(?!.*//)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*\\/$)[^\\u0000]+$"
    },
    "scores": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requirements",
        "correctness",
        "verification",
        "code_quality",
        "scope_discipline",
        "product_quality",
        "instruction_fidelity",
        "context_governance"
      ],
      "properties": {
        "requirements": {"type": "number", "minimum": 0, "maximum": 5},
        "correctness": {"type": "number", "minimum": 0, "maximum": 5},
        "verification": {"type": "number", "minimum": 0, "maximum": 5},
        "code_quality": {"type": "number", "minimum": 0, "maximum": 5},
        "scope_discipline": {"type": "number", "minimum": 0, "maximum": 5},
        "product_quality": {"type": "number", "minimum": 0, "maximum": 5},
        "instruction_fidelity": {"type": "number", "minimum": 0, "maximum": 5},
        "context_governance": {"type": "number", "minimum": 0, "maximum": 5}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "digest"],
      "properties": {
        "path": {"$ref": "#/$defs/safeRelativePath"},
        "digest": {"$ref": "#/$defs/digest"}
      }
    }
  }
}
